FROM container-registry.oracle.com/graalvm/native-image:21 AS builder

WORKDIR /app

COPY gradlew .
COPY gradle ./gradle
COPY build.gradle .
COPY settings.gradle .
COPY src ./src

RUN chmod +x ./gradlew

RUN ./gradlew --no-daemon nativeCompile

FROM debian:12-slim AS runner

RUN apt-get update && apt-get install -y zlib1g && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/build/native/nativeCompile/artifact.out .

EXPOSE 8080

ENTRYPOINT ["./artifact.out"]